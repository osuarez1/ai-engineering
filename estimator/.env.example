# LLM Provider configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# openai | anthropic | gemini — must match the API key set below
LLM_PROVIDER=openai

# Default model for the configured provider.
# Examples: gpt-4o-mini | claude-haiku-4-5 | gemini-2.0-flash
LLM_MODEL=gpt-4o-mini

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# Session memory and attachments
MAX_CONVERSATION_TURNS=6
MAX_ATTACHMENT_CHARS=60000

# LLM response cache (exact + semantic)
LLM_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.85

# Dynamic prompt tiers (enriched transcript size thresholds)
TIER_MEDIUM_CHARS=8000
TIER_HIGH_CHARS=20000
