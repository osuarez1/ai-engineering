# LLM Provider configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# openai | anthropic | gemini — must match the API key set below
LLM_PROVIDER=openai

# Default model for the configured provider. Can be overridden per request via
# the "model" field in POST /api/v1/estimate (handy for live A/B comparisons
# without restarting the server).
# Examples: gpt-4o-mini | claude-haiku-4-5 | gemini-2.0-flash
LLM_MODEL=gpt-4o-mini

# Application
APP_ENV=development
LOG_LEVEL=DEBUG
